{
  "include": ["src"],
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node"],
    "incremental": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "removeComments": false,
    "strict": true,
    "composite": true
  },
  "exclude": ["node_modules", "dist"]
}
